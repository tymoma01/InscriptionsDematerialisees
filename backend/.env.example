# Base de données (Neon PostgreSQL managé, région eu-central-1 Francfort)
# Connection string dans Azure Key Vault (voir backend/src/db/config.js), pas de DATABASE_URL ici.
# Deux secrets distincts selon NODE_ENV : "neon-connection-string-dev" (dev/local, par défaut ici
# puisque NODE_ENV n'est pas renseigné) et "neon-connection-string" (prod uniquement, quand
# NODE_ENV=production — voir Dockerfile).
# Chiffrement du NIR : clé aussi dans Azure Key Vault (secret "nir-encryption-key",
# voir backend/src/core/securite/nirCipher.js), jamais de clé ici.
# Secret de signature des cookies de session : aussi dans Azure Key Vault (secret
# "session-secret", voir backend/src/core/auth/session.js), même logique — jamais ici.

# Serveur
PORT=3000

# CORS (backend/src/app.js) : origine du front autorisée avec credentials — en local, le
# serveur Vite par défaut (port 5173). En production, l'URL du sous-domaine de l'entité.
FRONTEND_URL=http://localhost:5173

# Résolution d'entité (backend/src/api/middlewares/entiteContext.middleware.js) : en
# production la résolution se fait par sous-domaine ; en local (localhost, sans sous-domaine),
# ENTITE_PAR_DEFAUT sert de repli pour le développement — ex. "accecit".
ENTITE_PAR_DEFAUT=

# Liste de hostnames complets (séparés par des virgules) à traiter comme "utiliser
# ENTITE_PAR_DEFAUT", en plus de localhost/www/hostname mono-label déjà gérés par défaut —
# nécessaire pour un domaine personnalisé de prod dont le premier label n'est pas un code
# d'entité (ex. "inscriptions.accecit.com" → "inscriptions"). Cette instance ne servant
# actuellement qu'ACCECIT, pas de multi-tenant à résoudre ici.
HOTES_ENTITE_PAR_DEFAUT=inscriptions.accecit.com

# Azure OneDrive (stockage documents ACCECIT)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# OVH (stockage documents Adaptel) — en attente de décision (S3-compatible vs API native)
OVH_ENDPOINT=
OVH_ACCESS_KEY=
OVH_SECRET_KEY=

# AllMySMS
ALLMYSMS_API_LOGIN=
ALLMYSMS_API_PASSWORD=

# SmartOF
SMARTOF_API_URL=
SMARTOF_API_KEY=

# Sauvegarde quotidienne Neon (voir backend/scripts/sauvegarderNeon.js, docs/sauvegarde-neon.md)
# Clé de chiffrement du dump ("backup-encryption-key") dans Azure Key Vault, pas ici.
SAUVEGARDE_EMAIL_ALERTE=

# Crons in-process (backend/src/config/env.js) : activés par défaut hors production, désactivés
# par défaut si NODE_ENV=production (déclenchement prod via Azure Container Apps Jobs, voir
# backend/scripts/executer*ToutesEntites.js). Laisser vide pour garder le comportement par défaut ;
# ne renseigner que pour forcer explicitement (true/false).
ACTIVER_CRONS_INTERNES=
